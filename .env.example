# Database connection string (PostgreSQL / Vercel Postgres / Supabase / Neon)
DATABASE_URL="postgresql://user:password@localhost:5432/simple_image_links?schema=public"

# Vercel Blob token for cloud image storage
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_token_here"

# Optional Geolocation API key (if external service used instead of Vercel IP header)
GEOLOCATION_API_KEY=""

# Secret key for server-side auth / session encryption
AUTH_SECRET="super-secret-auth-key-change-in-production"
